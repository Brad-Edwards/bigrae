{
  "project_id": "example-builds",
  "project_number": "123456789012",
  "environment": "images",
  "name_prefix": "shifter-images",
  "github_org": "example-org",
  "github_repo": "example-repo",
  "github_repository_id": "123456789",
  "github_owner_id": "12345678",
  "github_subject_format": "immutable",
  "purpose_contexts": {
    "build": [
      {
        "environment": "gcp-image-build",
        "ref": "refs/heads/dev",
        "workflow_ref": "example-org/example-repo/.github/workflows/packer-gcp.yml@refs/heads/dev",
        "reusable_workflow_ref": ""
      },
      {
        "environment": "gcp-image-build",
        "ref": "refs/heads/main",
        "workflow_ref": "example-org/example-repo/.github/workflows/packer-gcp.yml@refs/heads/main",
        "reusable_workflow_ref": ""
      }
    ],
    "validate": [
      {
        "environment": "gcp-image-validate",
        "ref": "refs/heads/dev",
        "workflow_ref": "example-org/example-repo/.github/workflows/packer-gcp.yml@refs/heads/dev",
        "reusable_workflow_ref": ""
      },
      {
        "environment": "gcp-image-validate",
        "ref": "refs/heads/main",
        "workflow_ref": "example-org/example-repo/.github/workflows/packer-gcp.yml@refs/heads/main",
        "reusable_workflow_ref": ""
      }
    ]
  },
  "terraform_state_bucket_name": "example-builds-terraform-state",
  "release_evidence_bucket_name": "example-builds-release-evidence",
  "region": "us-central1",
  "enable_image_build_network": true,
  "enable_image_export_storage": true
}
