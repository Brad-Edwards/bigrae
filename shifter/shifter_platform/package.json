{
  "name": "shifter-platform",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "test": "jest",
    "test:coverage": "jest --coverage"
  },
  "jest": {
    "testEnvironment": "jsdom",
    "testMatch": [
      "**/static/js/**/*.test.js"
    ],
    "moduleNameMapper": {
      "^https://www\\.gstatic\\.com/firebasejs/[^/]+/firebase-app\\.js$": "<rootDir>/static/js/__mocks__/firebase-app.js",
      "^https://www\\.gstatic\\.com/firebasejs/[^/]+/firebase-auth\\.js$": "<rootDir>/static/js/__mocks__/firebase-auth.js"
    },
    "collectCoverageFrom": [
      "static/js/**/*.js",
      "!**/*.test.js",
      "!static/js/__mocks__/**"
    ],
    "coverageReporters": [
      "text",
      "lcov",
      "cobertura"
    ]
  },
  "devDependencies": {
    "@babel/core": "^8.0.1",
    "@babel/preset-env": "^8.0.2",
    "@eslint/js": "^10.0.1",
    "babel-jest": "^30.4.1",
    "eslint": "^10.3.0",
    "eslint-plugin-security": "^4.0.0",
    "globals": "^17.6.0",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "stylelint": "^17.11.1",
    "stylelint-config-standard": "^40.0.0"
  },
  "overrides": {
    "@istanbuljs/load-nyc-config": {
      "js-yaml": "^4.3.0"
    },
    "eslint": {
      "minimatch": "^11.0.3"
    },
    "@eslint/config-array": {
      "minimatch": "^11.0.3"
    },
    "babel-plugin-istanbul": "^8.0.2",
    "test-exclude": {
      "glob": "^14.0.3",
      "minimatch": "^11.0.3"
    },
    "@jest/reporters": {
      "glob": "^14.0.3"
    },
    "jest-config": {
      "glob": "^14.0.3"
    },
    "jest-runtime": {
      "glob": "^14.0.3"
    }
  }
}
